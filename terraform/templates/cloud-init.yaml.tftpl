#cloud-config

package_update: true
package_upgrade: false

packages:
  - ca-certificates
  - curl
  - htop
  - unzip

write_files:
  - path: /opt/minecraft/docker-compose.yml
    permissions: "0644"
    content: |
      services:
        mc:
          image: itzg/minecraft-server:java21
          container_name: minecraft
          restart: unless-stopped
          tty: true
          stdin_open: true
          ports:
            - "${minecraft_port}:25565"
          environment:
            EULA: "TRUE"
            TYPE: "PAPER"
            VERSION: "${minecraft_version}"
            MEMORY: "${java_memory}"
            USE_AIKAR_FLAGS: "true"
            TZ: "${timezone}"
            MOTD: "${motd}"
            DIFFICULTY: "${difficulty}"
            MAX_PLAYERS: "${max_players}"
            VIEW_DISTANCE: "10"
            SIMULATION_DISTANCE: "8"
            OPS: "${ops}"
            WHITELIST: "${whitelist}"
            ENFORCE_WHITELIST: "${enforce_whitelist}"
            ENABLE_RCON: "true"
            RCON_PASSWORD: "${rcon_password}"
          volumes:
            - ./data:/data
          healthcheck:
            test: ["CMD", "mc-health"]
            start_period: 2m
            interval: 30s
            retries: 10

        backup:
          image: itzg/mc-backup
          container_name: minecraft-backup
          restart: unless-stopped
          depends_on:
            - mc
          environment:
            BACKUP_INTERVAL: "6h"
            PRUNE_BACKUPS_DAYS: "7"
            RCON_HOST: "mc"
            RCON_PASSWORD: "${rcon_password}"
            TZ: "${timezone}"
          volumes:
            - ./data:/data:ro
            - ./backups:/backups

  - path: /etc/profile.d/minecraft.sh
    permissions: "0644"
    content: |
      alias mc-logs='docker logs -f --tail 100 minecraft'
      alias mc-console='docker exec -i minecraft rcon-cli'
      alias mc-restart='docker restart minecraft'
      alias mc-up='docker compose -f /opt/minecraft/docker-compose.yml up -d'
      alias mc-down='docker compose -f /opt/minecraft/docker-compose.yml down'

runcmd:
  - curl -fsSL https://get.docker.com -o /tmp/get-docker.sh
  - sh /tmp/get-docker.sh
  - systemctl enable --now docker
  - usermod -aG docker ubuntu
  - iptables -I INPUT 1 -p tcp --dport ${minecraft_port} -m conntrack --ctstate NEW -j ACCEPT
  - netfilter-persistent save || iptables-save > /etc/iptables/rules.v4
  - mkdir -p /opt/minecraft/data /opt/minecraft/backups
  - chown -R ubuntu:ubuntu /opt/minecraft
  - docker compose -f /opt/minecraft/docker-compose.yml up -d

final_message: "Provisioning finished after $UPTIME seconds."
