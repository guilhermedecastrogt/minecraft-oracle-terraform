tenancy_ocid     = "ocid1.tenancy.oc1..xxxxxxxxxxxxxxxxxxxxxxxx"
user_ocid        = "ocid1.user.oc1..xxxxxxxxxxxxxxxxxxxxxxxx"
fingerprint      = "aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"
private_key_path = "~/.oci/oci_api_key.pem"
region           = "sa-saopaulo-1"

ssh_public_key   = "ssh-ed25519 AAAAC3NzaC1... you@machine"
allowed_ssh_cidr = "0.0.0.0/0"

instance_ocpus     = 2
instance_memory_gb = 12
boot_volume_gb     = 100

panel_admin_email    = "you@example.com"
panel_admin_username = "admin"

# Leave empty to serve the panel over sslip.io, which needs no DNS setup.
panel_domain = ""

budget_alert_email = "you@example.com"
budget_amount      = 1
